{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Free Grind",
	"version": "0.5.2",
	"identifier": "dev.estopia.free-grind",
    "build": {
        "beforeDevCommand": "npm run dev:web",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
	"app": {
		"windows": [
			{
				"title": "Free Grind",
				"width": 1000,
				"height": 800,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"userAgent": "FreeGrind/0.5.2 (+https://freegrind.imaoreo.dev/; contact: support@imaoreo.dev)"
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"hotswap": {}
	}
}
